# DeHype Proxy Server Configuration (placeholder values only)
PORT=3000
GROQ_API_KEY=your_groq_api_key_here

# Required, at least 32 characters, not the placeholder: the server refuses to start otherwise.
# Must match SHARED_SECRET in the
# extension's scripts/config.js. Generate e.g. with: openssl rand -hex 32
SHARED_SECRET=replace_with_a_long_random_string

# Max JSON body size
BODY_LIMIT=200kb

# Per-IP rate limit: max requests per window (window in ms)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Reverse-proxy trust. Accepted: an integer hop count (e.g. 1), "loopback" or a comma-separated
# IP/subnet list, "true" (trust any X-Forwarded-For; spoofable, avoid) or "false".
# Leave unset when the server is exposed directly. Without it, clients behind a proxy share one IP bucket.
# TRUST_PROXY=1

# Comma-separated exact origins allowed by CORS. Empty = any chrome-extension:// origin.
# ALLOWED_ORIGINS=chrome-extension://your_extension_id_here
